{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    /* Repo-wide typecheck resolves workspace packages to source, so `pnpm typecheck`
       never depends on a prior build. Per-package builds resolve via node_modules. */
    "paths": {
      "@ticketing/contracts": ["packages/contracts/src/index.ts"],
      "@ticketing/logger": ["packages/logger/src/index.ts"],
      "@ticketing/http": ["packages/http/src/index.ts"],
      "@ticketing/kafka": ["packages/kafka/src/index.ts"],
      "@ticketing/testkit": ["packages/testkit/src/index.ts"]
    },
    "types": ["node"]
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "apps/*/src/**/*.ts", "apps/*/test/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "*.ts"],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
