# Copy to .env.local. The gateway is the only backend this app may call (PRD §13),
# and its CORS_ORIGINS must include this app's origin (http://localhost:3007).
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000

# Optional. Lets /api/proof's load generator past the gateway's rate limit so a
# concurrency demo is not throttled into meaninglessness. Server-side only — it is
# deliberately NOT NEXT_PUBLIC_, so the browser never sees it. Leave empty unless
# the gateway has the matching RATE_LIMIT_BYPASS_TOKEN set.
RATE_LIMIT_BYPASS_TOKEN=

# One-click sign-in for the accounts `pnpm seed` creates. Set DEMO_LOGINS=0 to
# remove the buttons entirely.
DEMO_LOGINS=1

# The platform_admin demo is opt-in, because that account can grant roles and
# read across every organizer. Set both to offer it; leave both empty and the
# admin row is not rendered and the route refuses the role. These must match
# BOOTSTRAP_ADMIN_* in the repo-root .env — the identity service reads those,
# this app cannot see them.
DEMO_ADMIN_EMAIL=organizer@demo.test
DEMO_ADMIN_PASSWORD=demo organizer passphrase
