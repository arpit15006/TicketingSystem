# ─── Shared ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── reservation (:3003) ─────────────────────────────────────────────────────
PORT=3003
HOST=0.0.0.0
DATABASE_URL=postgresql://reservation:reservation@localhost:5432/reservation_db

# PRD §8.1 — default hold duration is 480 seconds (8 minutes).
HOLD_DURATION_SECONDS=480
MAX_SEATS_PER_HOLD=10

PG_POOL_MAX=20
PG_STATEMENT_TIMEOUT_MS=10000

# ADR-003 — the janitor is cosmetic. Turning it off must never affect correctness,
# and every test in this repository runs with it disabled to prove that.
JANITOR_ENABLED=true
JANITOR_INTERVAL_MS=60000

# Phase 1 only: with no identity service yet, the caller asserts who it is via
# x-dev-user-id. This is attribution, not authorization — nothing grants a
# permission from it. Phase 2 introduces RS256 JWT verification and sets this to
# false, so the switch-off is a visible, testable event rather than a silent one.
ALLOW_DEV_IDENTITY_HEADER=true

# ADR-010 — every service verifies access tokens itself against identity's JWKS.
JWKS_URI=http://localhost:3001/.well-known/jwks.json
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=ticketing

# ─── identity (:3001) ────────────────────────────────────────────────────────
# PORT=3001
# DATABASE_URL=postgresql://identity:identity@localhost:5432/identity_db
ACCESS_TOKEN_TTL_SECONDS=600          # PRD §9.1 — 10 minutes
REFRESH_TOKEN_TTL_SECONDS=1209600     # PRD §9.1 — 14 days

# RS256 keypair. REQUIRED in production: a generated key is lost on restart, which
# would invalidate every live token and every cached JWKS.
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# JWT_KEY_ID=primary

# Registering with this address also grants platform_admin. It exists so the seed
# never needs database access to identity (ADR-004); the grant is logged at warn.
BOOTSTRAP_ADMIN_EMAIL=organizer@demo.test
BOOTSTRAP_ADMIN_PASSWORD=demo organizer passphrase

# ─── catalog (:3002) ─────────────────────────────────────────────────────────
# PORT=3002
# DATABASE_URL=postgresql://catalog:catalog@localhost:5432/catalog_db

# ─── gateway (:3000) ─────────────────────────────────────────────────────────
# PORT=3000
IDENTITY_URL=http://localhost:3001
CATALOG_URL=http://localhost:3002
RESERVATION_URL=http://localhost:3003
ORDERS_URL=http://localhost:3004
WAITING_ROOM_URL=http://localhost:3005
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

GATEWAY_URL=http://localhost:3000

# ─── Phases 3-5 (not built yet; listed so this file stays the single reference) ─
# orders    :3004  DATABASE_URL=postgresql://orders:orders@localhost:5432/orders_db
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# REDIS_URL=redis://localhost:6379
# KAFKA_BROKERS=localhost:9092
