# ─── Shared ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── reservation (:3003) ─────────────────────────────────────────────────────
PORT=3003
HOST=0.0.0.0
DATABASE_URL=postgresql://reservation:reservation@localhost:5432/reservation_db

# PRD §8.1 — default hold duration is 480 seconds (8 minutes).
HOLD_DURATION_SECONDS=480
MAX_SEATS_PER_HOLD=10

PG_POOL_MAX=20
PG_STATEMENT_TIMEOUT_MS=10000

# ADR-003 — the janitor is cosmetic. Turning it off must never affect correctness,
# and every test in this repository runs with it disabled to prove that.
JANITOR_ENABLED=true
JANITOR_INTERVAL_MS=60000

# Phase 1 only: with no identity service yet, the caller asserts who it is via
# x-dev-user-id. This is attribution, not authorization — nothing grants a
# permission from it. Phase 2 introduces RS256 JWT verification and sets this to
# false, so the switch-off is a visible, testable event rather than a silent one.
ALLOW_DEV_IDENTITY_HEADER=true

# ADR-010 — every service verifies access tokens itself against identity's JWKS.
JWKS_URI=http://localhost:3001/.well-known/jwks.json
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=ticketing

# ─── identity (:3001) ────────────────────────────────────────────────────────
# PORT=3001
# DATABASE_URL=postgresql://identity:identity@localhost:5432/identity_db
ACCESS_TOKEN_TTL_SECONDS=600          # PRD §9.1 — 10 minutes
REFRESH_TOKEN_TTL_SECONDS=1209600     # PRD §9.1 — 14 days

# RS256 keypair. REQUIRED in production: a generated key is lost on restart, which
# would invalidate every live token and every cached JWKS.
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# JWT_KEY_ID=primary

# Registering with this address also grants platform_admin. It exists so the seed
# never needs database access to identity (ADR-004); the grant is logged at warn.
BOOTSTRAP_ADMIN_EMAIL=organizer@demo.test
BOOTSTRAP_ADMIN_PASSWORD=demo organizer passphrase

# ─── catalog (:3002) ─────────────────────────────────────────────────────────
# PORT=3002
# DATABASE_URL=postgresql://catalog:catalog@localhost:5432/catalog_db
# Catalog grants the creator organizer:event:<id> / venue_admin:venue:<id> through
# identity's internal route, using INTERNAL_SERVICE_TOKEN.
# IDENTITY_URL=http://localhost:3001

# ─── gateway (:3000) ─────────────────────────────────────────────────────────
# PORT=3000
IDENTITY_URL=http://localhost:3001
CATALOG_URL=http://localhost:3002
RESERVATION_URL=http://localhost:3003
ORDERS_URL=http://localhost:3004
WAITING_ROOM_URL=http://localhost:3005
NOTIFICATION_URL=http://localhost:3006
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# PRD §13 — the browser talks only to the gateway, so this is the platform's whole
# CORS surface. Comma-separated exact origins; never a wildcard. apps/web runs on
# 3007 because the gateway owns 3000 and notification owns 3006.
CORS_ORIGINS=http://localhost:3007

GATEWAY_URL=http://localhost:3000

# ─── orders (:3004) ──────────────────────────────────────────────────────────
# PORT=3004
# DATABASE_URL=postgresql://orders:orders@localhost:5432/orders_db
CURRENCY=INR

# PRD §10.1.3 / ADR-008 — refuse to start a payment with less hold than this left.
# This is what bounds the payment-after-expiry race; the compensation path handles
# whatever is left over.
MIN_HOLD_SECONDS_FOR_ORDER=90
HOLD_EXTENSION_SECONDS=600

# Razorpay. REAL VALUES BELONG IN .env, WHICH IS GITIGNORED — never here.
RAZORPAY_BASE_URL=https://api.razorpay.com
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# NOTE: this is a DIFFERENT secret from RAZORPAY_KEY_SECRET. You generate it in the
# Razorpay dashboard under Settings → Webhooks, and webhook signatures are verified
# with it (PRD §10.3). Using the API key secret here will fail every webhook.
RAZORPAY_WEBHOOK_SECRET=

# Shared secret proving a caller is another service rather than an end user.
# Guards seat finalization, hold extension and hold lookup — endpoints a user must
# never be able to call directly.
INTERNAL_SERVICE_TOKEN=dev-internal-service-token-change-me

# ─── Kafka / Redpanda (ADR-005) ──────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# The outbox relay is a background worker, never on the correctness path. Turning
# it off delays events; it can never oversell a seat or lose one (INV-7).
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_INTERVAL_MS=500

# ─── notification (:3006) ────────────────────────────────────────────────────
# PORT=3006
# DATABASE_URL=postgresql://notification:notification@localhost:5432/notification_db
CONSUMER_GROUP_ID=notification

# ─── Redis (ADR-012 — holds NO correctness state) ────────────────────────────
# Used for the waiting-room queue, the jti denylist, rate limiting and seatmap
# caching. Never consulted to decide whether a seat is available. Every use of it
# fails OPEN: if Redis is gone the waiting room admits everyone, seatmap reads fall
# back to Postgres, and seat allocation is still exactly correct.
REDIS_URL=redis://localhost:6379

# ─── waitingroom (:3005) ─────────────────────────────────────────────────────
# PORT=3005
# Symmetric on purpose: an admission token grants a place in a queue and nothing
# else. Forging one skips a queue; it confers no authority over a seat or money.
ADMISSION_TOKEN_SECRET=dev-admission-secret-change-me
ADMISSION_TTL_SECONDS=600
ADMISSION_RATE_PER_SECOND=50
ADMITTER_INTERVAL_MS=1000
SSE_POSITION_INTERVAL_MS=2000

# Reservation enforces admission for waiting-room events; this is the global off
# switch. Enforcement fails open on every infrastructure failure.
WAITING_ROOM_ENFORCEMENT_ENABLED=true
SEATMAP_CACHE_TTL_SECONDS=5
