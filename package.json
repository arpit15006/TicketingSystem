{
  "name": "ticketing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @ticketing/web typecheck",
    "lint": "eslint . && pnpm --filter @ticketing/web lint",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:oversell": "vitest run --project integration -t oversell",
    "test:regression": "vitest run",
    "seed": "node scripts/seed.ts",
    "keys:generate": "node scripts/generate-keys.ts",
    "dev:web": "pnpm --filter @ticketing/web dev",
    "stack:up": "docker compose -f infra/docker-compose.yml --env-file .env up -d --wait",
    "stack:build": "docker compose -f infra/docker-compose.yml --env-file .env up -d --build --wait",
    "stack:down": "docker compose -f infra/docker-compose.yml --env-file .env down",
    "stack:logs": "docker compose -f infra/docker-compose.yml --env-file .env logs -f",
    "stack:ps": "docker compose -f infra/docker-compose.yml --env-file .env ps"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testcontainers/redpanda": "^12.1.0",
    "@ticketing/testkit": "workspace:*",
    "@types/node": "^22.19.2",
    "@types/pg": "^8.15.6",
    "eslint": "^9.39.1",
    "kafkajs": "^2.2.4",
    "pg": "^8.16.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4",
    "jose": "^6.1.0"
  }
}
